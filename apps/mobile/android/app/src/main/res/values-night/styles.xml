<resources>
    <style name="Theme.Lagom" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#1E1E1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <!-- Same background as the first screen, so the splash hands over without a colour jump. -->
    <style name="Theme.Lagom.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E1E1E</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Lagom</item>
    </style>
</resources>
