// shortcut: GPUI 0.2.2 has no runtime icon setter and loads resource 1 for its windows, revisit when it exposes an icon API.
1 ICON "../../brand/app-icon/export/lagom.ico"

1 VERSIONINFO
// build.rs defines the numbers from LAGOM_VERSION, the tag (docs/release.md).
FILEVERSION LAGOM_MAJOR,LAGOM_MINOR,LAGOM_PATCH,0
PRODUCTVERSION LAGOM_MAJOR,LAGOM_MINOR,LAGOM_PATCH,0
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "lagom\0"
            VALUE "FileDescription", "lagom\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
