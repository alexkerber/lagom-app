// shortcut: GPUI 0.2.2 has no runtime icon setter and loads resource 1 for its windows, revisit when it exposes an icon API.
1 ICON "../../brand/app-icon/export/lagom.ico"

1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "lagom\0"
            VALUE "FileDescription", "lagom\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
