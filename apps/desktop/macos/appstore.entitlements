<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only (LAGOM_MAS=1 scripts/package-macos.sh). The dmg build is not sandboxed. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- IMAP, SMTP and HTTPS to the user's own servers; remote images in the reading pane. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- Google and Microsoft sign-in receive the browser callback on a loopback listener. -->
    <key>com.apple.security.network.server</key><true/>
    <!-- Received attachments are saved to Downloads (lagom-core attachment.rs). -->
    <key>com.apple.security.files.downloads.read-write</key><true/>
    <!-- Attach files: the open panel in compose. -->
    <key>com.apple.security.files.user-selected.read-only</key><true/>
</dict>
</plist>
